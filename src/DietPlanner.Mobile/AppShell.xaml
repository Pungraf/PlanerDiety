<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="DietPlanner.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    FlyoutBehavior="Disabled">
    <ShellContent
        x:Name="LoginShellContent"
        Route="login"
        Title="Sign in"
        Shell.FlyoutItemIsVisible="False" />
    <TabBar Route="main">
        <ShellContent
            x:Name="HomeShellContent"
            Route="home"
            Title="Home" />
        <ShellContent
            x:Name="ShoppingListShellContent"
            Route="shopping-list"
            Title="Shopping list" />
    </TabBar>
</Shell>
