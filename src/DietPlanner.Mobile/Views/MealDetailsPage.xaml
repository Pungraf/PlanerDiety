<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DietPlanner.Mobile.Views.MealDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Recipe">
    <Grid RowDefinitions="Auto,*" Padding="20">
        <VerticalStackLayout Spacing="12">
            <Label FontSize="26" FontAttributes="Bold" Text="{Binding Name}" />
            <Label Text="{Binding MacroSummary}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsLoading}"
                Spacing="12"
                VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
                <Label HorizontalTextAlignment="Center" Text="Loading recipe..." />
            </VerticalStackLayout>

            <VerticalStackLayout
                IsVisible="{Binding HasError}"
                Spacing="12"
                VerticalOptions="Center">
                <Label FontAttributes="Bold" HorizontalTextAlignment="Center" Text="Could not load recipe" />
                <Label HorizontalTextAlignment="Center" Text="{Binding ErrorMessage}" />
            </VerticalStackLayout>

            <CollectionView IsVisible="{Binding HasContent}" ItemsSource="{Binding Ingredients}">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="12">
                        <Label FontAttributes="Bold" Text="Ingredients" />
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,8" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label FontAttributes="Bold" Text="{Binding Name}" />
                                <Label Text="{Binding Category}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding QuantityText}" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,12,0,0" Spacing="8">
                        <Label FontAttributes="Bold" Text="Preparation" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PreparationSteps}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" StrokeThickness="0">
                                        <Label Text="{Binding Text}" LineBreakMode="WordWrap" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
